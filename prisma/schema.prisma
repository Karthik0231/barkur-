  templeLocation String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model DailySchedule {
  id          String   @id @default(uuid()) @db.Uuid
  dayOfWeek   Int
