generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String              @id @default(uuid()) @db.Uuid
  name                       String
  email                      String?             @unique
  phone                      String?
  password                   String?
  image                      String?
  role                       UserRole            @default(DEVOTEE)
  emailVerified              DateTime?
  isActive                   Boolean             @default(true)
  twoFactorEnabled           Boolean             @default(false)
  refreshToken               String?
  lastLogin                  DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  createdBy                  String?             @db.Uuid
  updatedBy                  String?             @db.Uuid
  accounts                   Account[]
  createdAnnouncements       Announcement[]      @relation("AnnouncementCreatedBy")
  auditLogs                  AuditLog[]
  createdBlogs               Blog[]              @relation("BlogCreatedBy")
  updatedBlogs               Blog[]              @relation("BlogUpdatedBy")
  approvedBookings           Booking[]           @relation("BookingApprovedBy")
  createdBookings            Booking[]           @relation("BookingCreatedBy")
  bookings                   Booking[]
  repliedContacts            Contact[]           @relation("ContactRepliedBy")
  createdDonationCampaigns   DonationCampaign[]  @relation("DonationCampaignCreatedBy")
  updatedDonationCampaigns   DonationCampaign[]  @relation("DonationCampaignUpdatedBy")
  resolvedFeedbacks          Feedback[]          @relation("FeedbackResolvedBy")
  feedbacks                  Feedback[]
  createdFestivals           Festival[]          @relation("FestivalCreatedBy")
  updatedFestivals           Festival[]          @relation("FestivalUpdatedBy")
  createdGalleries           Gallery[]           @relation("GalleryCreatedBy")
  createdHalls               Hall[]              @relation("HallCreatedBy")
  approvedHallBookings       HallBooking[]       @relation("HallBookingApprovedBy")
  createdHallBookings        HallBooking[]       @relation("HallBookingCreatedBy")
  hallBookings               HallBooking[]
  createdNews                News[]              @relation("NewsCreatedBy")
  notifications              Notification[]
  sessions                   Session[]
  createdSevas               Seva[]              @relation("SevaCreatedBy")
  updatedSevas               Seva[]              @relation("SevaUpdatedBy")
  createdSevaCategories      SevaCategory[]      @relation("SevaCategoryCreatedBy")
  approvedShashwathaBookings ShashwathaBooking[] @relation("ShashwathaApprovedBy")
  shashwathaBookings         ShashwathaBooking[]
  creator                    User?               @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers               User[]              @relation("UserCreatedBy")
  updater                    User?               @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers               User[]              @relation("UserUpdatedBy")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  role         UserRole
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([permissionId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model TempleSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  group       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
}

model SevaCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  sevas       Seva[]
  creator     User?     @relation("SevaCategoryCreatedBy", fields: [createdBy], references: [id])

  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Seva {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  slug                String              @unique
  categoryId          String              @db.Uuid
  description         String?
  shortDescription    String?
  images              Json?
  price               Decimal             @db.Decimal(10, 2)
  originalPrice       Decimal?            @db.Decimal(10, 2)
  duration            Int?
  maxDevotees         Int?
  minDevotees         Int?
  rules               Json?
  specialInstructions Json?
  isShashwatha        Boolean             @default(false)
  shashwathaType      ShashwathaType?
  isSpecial           Boolean             @default(false)
  isActive            Boolean             @default(true)
  bookingNotice       Int?
  requiresApproval    Boolean             @default(false)
  sortOrder           Int                 @default(0)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           String?             @db.Uuid
  updatedBy           String?             @db.Uuid
  bookingItems        BookingItem[]
  category            SevaCategory        @relation(fields: [categoryId], references: [id])
  creator             User?               @relation("SevaCreatedBy", fields: [createdBy], references: [id])
  updater             User?               @relation("SevaUpdatedBy", fields: [updatedBy], references: [id])
  sevaDates           SevaDate[]
  sevaTimeSlots       SevaTimeSlot[]
  shashwathaBookings  ShashwathaBooking[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isSpecial])
  @@index([sortOrder])
  @@index([deletedAt])
}

model SevaDate {
  id           String         @id @default(uuid()) @db.Uuid
  sevaId       String         @db.Uuid
  date         DateTime
  isAvailable  Boolean        @default(true)
  maxBookings  Int?
  bookedCount  Int            @default(0)
  blockedDates Json?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  seva         Seva           @relation(fields: [sevaId], references: [id], onDelete: Cascade)
  timeSlots    SevaTimeSlot[]

  @@unique([sevaId, date])
  @@index([date])
  @@index([isAvailable])
}

model SevaTimeSlot {
  id          String   @id @default(uuid()) @db.Uuid
  sevaId      String   @db.Uuid
  dateId      String   @db.Uuid
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)
  maxBookings Int?
  bookedCount Int      @default(0)
  createdAt   DateTime @default(now())
  date        SevaDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  seva        Seva     @relation(fields: [sevaId], references: [id], onDelete: Cascade)

  @@index([sevaId])
  @@index([dateId])
  @@index([isAvailable])
}

model DevoteeDetail {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  gotra        String?
  nakshatra    String?
  rashi        String?
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  district     String?
  pincode      String?
  country      String?
  createdAt    DateTime      @default(now())
  bookingItems BookingItem[]

  @@index([phone])
  @@index([email])
}

model Booking {
  id                  String               @id @default(uuid()) @db.Uuid
  bookingId           String               @unique
  userId              String               @db.Uuid
  sevaDateId          String?              @db.Uuid
  totalAmount         Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal?             @db.Decimal(10, 2)
  finalAmount         Decimal              @db.Decimal(10, 2)
  paymentStatus       BookingPaymentStatus @default(PENDING)
  bookingStatus       BookingStatus        @default(PENDING)
  status              String?
  isShashwatha        Boolean              @default(false)
  shashwathaType      ShashwathaType?
  shashwathaDetails   Json?
  devoteeDetails      Json?
  specialInstructions Json?
  remarks             String?
  preferredDate       DateTime?
  preferredTime       String?
  quantity            Int                  @default(1)
  slotId              String?              @db.Uuid
  adminApproval       AdminApproval        @default(PENDING)
  approvedBy          String?              @db.Uuid
  approvedAt          DateTime?
  cancellationReason  String?
  refundAmount        Decimal?             @db.Decimal(10, 2)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?              @db.Uuid
  approver            User?                @relation("BookingApprovedBy", fields: [approvedBy], references: [id])
  creator             User?                @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  sevaDate            SevaDate?            @relation(fields: [sevaDateId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  items               BookingItem[]
  certificates        Certificate[]
  payments            Payment[]
  receipts            Receipt[]

  @@index([userId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([adminApproval])
  @@index([deletedAt])
  @@index([createdAt])
}

model BookingItem {
  id                  String         @id @default(uuid()) @db.Uuid
  bookingId           String         @db.Uuid
  sevaId              String         @db.Uuid
  devoteeDetailId     String?        @db.Uuid
  devoteeName         String?
  gotra               String?
  nakshatra           String?
  rashi               String?
  quantity            Int            @default(1)
  unitPrice           Decimal        @db.Decimal(10, 2)
  totalPrice          Decimal        @db.Decimal(10, 2)
  specialInstructions String?
  createdAt           DateTime       @default(now())
  booking             Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  devoteeDetail       DevoteeDetail? @relation(fields: [devoteeDetailId], references: [id])
  seva                Seva           @relation(fields: [sevaId], references: [id])

  @@index([bookingId])
  @@index([sevaId])
  @@index([devoteeDetailId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @db.Uuid
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  gatewayResponse   Json?
  receiptUrl        String?
  invoiceUrl        String?
  refundId          String?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  refundReason      String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  donations         Donation[]
  booking           Booking       @relation(fields: [bookingId], references: [id])
  paymentLogs       PaymentLog[]
  receipts          Receipt[]

  @@index([bookingId])
  @@index([status])
  @@index([paidAt])
}

model PaymentLog {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  action    String
  status    String?
  response  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Certificate {
  id                String          @id @default(uuid()) @db.Uuid
  bookingId         String          @db.Uuid
  certificateNumber String          @unique
  type              CertificateType
  template          String?
  metadata          Json?
  issuedAt          DateTime?
  createdAt         DateTime        @default(now())
  booking           Booking         @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([type])
}

model Receipt {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @db.Uuid
  receiptNumber String    @unique
  paymentId     String?   @db.Uuid
  amount        Decimal   @db.Decimal(10, 2)
  taxAmount     Decimal?  @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  type          String?
  metadata      Json?
  pdfUrl        String?
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())
  booking       Booking   @relation(fields: [bookingId], references: [id])
  payment       Payment?  @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([paymentId])
}

model DonationCampaign {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  slug             String           @unique
  description      String?
  shortDescription String?
  banner           String?
  goalAmount       Decimal          @db.Decimal(12, 2)
  collectedAmount  Decimal          @default(0) @db.Decimal(12, 2)
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  category         DonationCategory @default(GENERAL)
  rules            Json?
  images           Json?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String?          @db.Uuid
  updatedBy        String?          @db.Uuid
  donations        Donation[]
  creator          User?            @relation("DonationCampaignCreatedBy", fields: [createdBy], references: [id])
  updater          User?            @relation("DonationCampaignUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isActive])
  @@index([category])
  @@index([isFeatured])
  @@index([deletedAt])
}

model Donation {
  id            String            @id @default(uuid()) @db.Uuid
  donationId    String            @unique
  campaignId    String?           @db.Uuid
  donorName     String
  donorEmail    String?
  donorPhone    String?
  amount        Decimal           @db.Decimal(10, 2)
  message       String?
  isAnonymous   Boolean           @default(false)
  isRecurring   Boolean           @default(false)
  recurringType RecurringType?
  paymentId     String?           @db.Uuid
  receiptId     String?           @db.Uuid
  receiptNumber String?
  status        String?
  panNumber     String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  pincode       String?
  taxBenefit    Boolean           @default(false)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  campaign      DonationCampaign? @relation(fields: [campaignId], references: [id])
  payment       Payment?          @relation(fields: [paymentId], references: [id])

  @@index([campaignId])
  @@index([donorEmail])
  @@index([status])
  @@index([deletedAt])
}

model Hall {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  description     String?
  capacity        Int?
  images          Json?
  amenities       Json?
  rules           Json?
  basePrice       Decimal?           @db.Decimal(10, 2)
  pricePerHour    Decimal?           @db.Decimal(10, 2)
  pricePerDay     Decimal?           @db.Decimal(10, 2)
  securityDeposit Decimal?           @db.Decimal(10, 2)
  isActive        Boolean            @default(true)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       String?            @db.Uuid
  creator         User?              @relation("HallCreatedBy", fields: [createdBy], references: [id])
  availabilities  HallAvailability[]
  bookings        HallBooking[]

  @@index([isActive])
  @@index([deletedAt])
}

model HallBooking {
  id                 String               @id @default(uuid()) @db.Uuid
  bookingId          String               @unique
  hallId             String               @db.Uuid
  userId             String               @db.Uuid
  eventName          String
  eventType          String?
  organizerName      String
  organizerPhone     String
  organizerEmail     String?
  bookingDate        DateTime
  startTime          DateTime
  endTime            DateTime
  totalAmount        Decimal              @db.Decimal(10, 2)
  securityDeposit    Decimal?             @db.Decimal(10, 2)
  discountAmount     Decimal?             @db.Decimal(10, 2)
  finalAmount        Decimal              @db.Decimal(10, 2)
  purpose            String?
  expectedGuests     Int?
  specialRequests    String?
  paymentId          String?              @db.Uuid
  paymentStatus      BookingPaymentStatus @default(PENDING)
  bookingStatus      BookingStatus        @default(PENDING)
  adminApproval      AdminApproval        @default(PENDING)
  approvedBy         String?              @db.Uuid
  approvedAt         DateTime?
  cancellationReason String?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdBy          String?              @db.Uuid
  approver           User?                @relation("HallBookingApprovedBy", fields: [approvedBy], references: [id])
  creator            User?                @relation("HallBookingCreatedBy", fields: [createdBy], references: [id])
  hall               Hall                 @relation(fields: [hallId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])

  @@index([hallId])
  @@index([userId])
  @@index([bookingDate])
  @@index([bookingStatus])
  @@index([deletedAt])
}

model HallAvailability {
  id          String    @id @default(uuid()) @db.Uuid
  hallId      String    @db.Uuid
  date        DateTime
  isAvailable Boolean   @default(true)
  startTime   DateTime?
  endTime     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hall        Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@unique([hallId, date])
  @@index([date])
  @@index([isAvailable])
}

model Festival {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  slug             String    @unique
  description      String?
  shortDescription String?
  category         String?
  date             DateTime?
  startDate        DateTime?
  endDate          DateTime?
  isMultiDay       Boolean   @default(false)
  image            String?
  images           Json?
  rituals          Json?
  significance     String?
  history          String?
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  events           Event[]
  creator          User?     @relation("FestivalCreatedBy", fields: [createdBy], references: [id])
  updater          User?     @relation("FestivalUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isActive])
  @@index([category])
  @@index([isFeatured])
  @@index([deletedAt])
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  festivalId  String?   @db.Uuid
  name        String
  description String?
  date        DateTime?
  startTime   DateTime?
  endTime     DateTime?
  location    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([festivalId])
  @@index([date])
  @@index([isActive])
}

model Blog {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  slug           String    @unique
  excerpt        String?
  content        String?
  category       String?
  tags           Json?
  featuredImage  String?
  images         Json?
  author         String?
  isPublished    Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  viewCount      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  creator        User?     @relation("BlogCreatedBy", fields: [createdBy], references: [id])
  updater        User?     @relation("BlogUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isPublished])
  @@index([category])
  @@index([author])
  @@index([deletedAt])
  @@index([publishedAt])
}

model News {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  slug           String    @unique
  excerpt        String?
  content        String?
  category       String?
  source         String?
  isUrgent       Boolean   @default(false)
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  featuredImage  String?
  tags           Json?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  viewCount      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  creator        User?     @relation("NewsCreatedBy", fields: [createdBy], references: [id])

  @@index([isPublished])
  @@index([isUrgent])
  @@index([category])
  @@index([deletedAt])
  @@index([publishedAt])
}

model Announcement {
  id        String           @id @default(uuid()) @db.Uuid
  title     String
  content   String?
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true)
  isPopup   Boolean          @default(false)
  startDate DateTime?
  endDate   DateTime?
  link      String?
  linkText  String?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  createdBy String?          @db.Uuid
  creator   User?            @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])

  @@index([isActive])
  @@index([type])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

model Gallery {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  slug        String          @unique
  description String?
  image       String?
  images      Json?
  videoUrl    String?
  type        GalleryType     @default(IMAGE)
  category    GalleryCategory @default(OTHER)
  tags        Json?
  isFeatured  Boolean         @default(false)
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?         @db.Uuid
  creator     User?           @relation("GalleryCreatedBy", fields: [createdBy], references: [id])

  @@index([type])
  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Testimonial {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  role       String?
  content    String
  rating     Int?
  avatar     String?
  isFeatured Boolean   @default(false)
  isApproved Boolean   @default(false)
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isFeatured])
  @@index([isApproved])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Committee {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  role        String?
  type        CommitteeMemberType
  photo       String?
  biography   String?
  email       String?
  phone       String?
  tenureStart DateTime?
  tenureEnd   DateTime?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model FAQ {
  id        String    @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  category  String?
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  repliedBy String?   @db.Uuid
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  replier   User?     @relation("ContactRepliedBy", fields: [repliedBy], references: [id])

  @@index([email])
  @@index([isRead])
  @@index([category])
  @@index([deletedAt])
  @@index([createdAt])
}

model Newsletter {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model Panchanga {
  id               String   @id @default(uuid()) @db.Uuid
  date             DateTime @unique
  tithi            String?
  nakshatra        String?
  yoga             String?
  karana           String?
  sunrise          String?
  sunset           String?
  moonrise         String?
  moonset          String?
  rahuKala         String?
  yamaganda        String?
  gulika           String?
  durmuhurta       String?
  amritaKala       String?
  abhijitMuhurta   String?
  varjyam          String?
  auspiciousTime   String?
  inauspiciousTime String?
  festival         String?
  special          String?
  isEkadashi       Boolean  @default(false)
  isAmavasya       Boolean  @default(false)
  isPournami       Boolean  @default(false)
  month            String?
  masa             String?
  ritu             String?
  ayana            String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([isEkadashi])
  @@index([isAmavasya])
  @@index([isPournami])
}

model OTP {
  id        String     @id @default(uuid()) @db.Uuid
  email     String?
  phone     String?
  otp       String
  type      OTPType
  purpose   OTPPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([email])
  @@index([phone])
  @@index([otp, email, isUsed])
  @@index([expiresAt])
}

model Feedback {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  name       String?
  email      String?
  rating     Int?
  category   String?
  subject    String?
  message    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?   @db.Uuid
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolver   User?     @relation("FeedbackResolvedBy", fields: [resolvedBy], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isResolved])
  @@index([category])
  @@index([deletedAt])
}

model SEO {
  id            String   @id @default(uuid()) @db.Uuid
  page          String   @unique
  title         String?
  description   String?
  keywords      String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  twitterCard   String?
  canonicalUrl  String?
  schemaMarkup  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailLog {
  id        String      @id @default(uuid()) @db.Uuid
  to        String
  from      String?
  subject   String?
  template  String?
  body      String?
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([status])
  @@index([sentAt])
  @@index([to])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String?
  type      NotificationType @default(GENERAL)
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model Family {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  headName     String?
  headPhone    String?
  headEmail    String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  membersCount Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model SubDeity {
  id             String    @id @default(uuid()) @db.Uuid
