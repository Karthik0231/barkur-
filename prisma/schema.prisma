  updatedAt      DateTime @updatedAt

  @@index([isActive])
}

model ShashwathaBooking {
  id             String         @id @default(uuid()) @db.Uuid
  bookingId      String         @unique
  userId         String         @db.Uuid
  sevaId         String         @db.Uuid
  shashwathaType ShashwathaType
  selectedDate   DateTime?
  simhaMasaDay   Int?
  navaratriDay   Int?
  isLifetime     Boolean        @default(false)
  startYear      Int?
  amount         Decimal?       @db.Decimal(10, 2)
  paymentId      String?        @db.Uuid
  receiptId      String?        @db.Uuid
  certificateId  String?        @db.Uuid
  status         String?
  adminApproval  AdminApproval  @default(PENDING)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approvedBy     String?        @db.Uuid
  approver       User?          @relation("ShashwathaApprovedBy", fields: [approvedBy], references: [id])
  seva           Seva           @relation(fields: [sevaId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sevaId])
  @@index([shashwathaType])
  @@index([status])
  @@index([deletedAt])
}

